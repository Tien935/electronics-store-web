# =========================================================================
# TECH-MART AI SERVICE CONFIGURATION (.env.example)
# =========================================================================

# --- Gemini AI ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Cổng riêng của AI Service (Không bị trùng các service khác) ---
PORT=8085
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3001

# --- ChromaDB ---
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=phones
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.85

# =========================================================================
# KẾT NỐI SẴN CỔNG TỚI CÁC SERVICE KHÁC (NGƯỜI SAU CODE XONG LÀ TỰ ĂN)
# =========================================================================
GATEWAY_URL=http://localhost:8080
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
DISCOVERY_SERVER_URL=http://localhost:8761
FRONTEND_URL=http://localhost:3000

# Chế độ tự động fallback
USE_MOCK_INVENTORY=true
